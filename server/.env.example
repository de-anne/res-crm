# Copy to .env and adjust for your environment.

# Port the API listens on
PORT=4000

# Secret used to sign JWT auth tokens — CHANGE THIS to a long random string.
JWT_SECRET=please-change-me-to-a-long-random-string

# Where the SQLite database file is stored (defaults to server/data)
# CRM_DATA_DIR=./data

# Comma-separated list of allowed site origins for CORS (split hosting).
# Leave unset to allow any origin. For DreamHost + Render set it to your site:
# CORS_ORIGIN=https://crm.anneneo.com
